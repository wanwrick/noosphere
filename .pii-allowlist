# .pii-allowlist — known-safe matches for scripts/lint_pii.sh
#
# Each line is a regex matched against the MATCHED TEXT (not the whole line),
# anchored implicitly as a full match. A rule hit whose matched text matches
# any line here is dropped before the gate decides pass/fail.
#
# Matching on the matched text rather than the line keeps this precise: a line
# that carries both a documentation IP and a real one still fails.
#
# Blank lines and # comments are ignored. Keep every entry justified.

# --- Reserved / documentation values that identify nobody -------------------
# RFC 2606 reserved domains.
[A-Za-z0-9._%+-]+@(?:example|invalid|test|localhost)\.(?:com|org|net|edu)
[A-Za-z0-9._%+-]+@example\.[A-Za-z]{2,}
# Placeholder domains used throughout the templates.
[A-Za-z0-9._%+-]+@(?:yourcompany|company|domain|acme|employer|client)\.[A-Za-z]{2,}
# Bot / no-reply identities. Not personal correspondence addresses.
(?:noreply|no-reply)@[A-Za-z0-9.-]+
[A-Za-z0-9._%+-]+@users\.noreply\.github\.com

# --- Reserved IP ranges -----------------------------------------------------
# RFC 5737 documentation ranges.
192\.0\.2\.\d{1,3}
198\.51\.100\.\d{1,3}
203\.0\.113\.\d{1,3}
# RFC 1918 private space, loopback, unspecified, broadcast. Route to no person.
10\.\d{1,3}\.\d{1,3}\.\d{1,3}
192\.168\.\d{1,3}\.\d{1,3}
172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}
127\.\d{1,3}\.\d{1,3}\.\d{1,3}
0\.0\.0\.0
255\.255\.255\.(?:0|255)

# --- Reserved test numbers --------------------------------------------------
# NANP 555-01xx block is reserved for fiction and documentation.
(?:\+?1[ .-]?)?\(?\d{3}\)?[ .-]555[ .-]01\d{2}

# --- Author's own published byline ------------------------------------------
# The practice OS is published under its author's name by design; the profile
# link is a deliberate byline, not a leak. Reviewed 2026-08-30. Narrow on
# purpose: any OTHER profile URL still raises a warning.
linkedin\.com/in/parozmehta
